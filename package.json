    "html-to-image": "^1.11.13",
    "motion": "^14.9.0",
    "nanoid": "^6.0.2",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "postgres": "^4.0.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "^0.3.2",
