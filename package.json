    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.5.14",
    "@phosphor-icons/react": "^2.1.10",
    "ai": "^7.0.161",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cuelume": "^0.2.8",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
