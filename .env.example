# ── Auth (Clerk) ────────────────────────────────────────────────
# Quickest: `npx clerk@latest init --accountless --framework next` writes temporary dev keys to .env.local.
# Or copy them from https://dashboard.clerk.com → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Database ────────────────────────────────────────────────────
# Leave empty for local dev: an embedded Postgres (PGlite) is created in ./.data and seeded.
# For deploys, any Postgres works (Neon, Supabase, RDS…).
# DATABASE_URL          = pooled connection, used by the app at runtime (Neon: host contains "-pooler")
# DATABASE_URL_UNPOOLED = direct connection, used for migrations at build time (optional, falls back to DATABASE_URL)
# SEED_DEMO=true        = insert the demo users/recipes on deploy if the database is empty
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── AI (optional) ───────────────────────────────────────────────
# First one found wins. Without a key, AI features show an "offline" state and imports use the deterministic parsers.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_GATEWAY_API_KEY=
# AI_MODEL=claude-sonnet-5-5   # override the default model id for the chosen provider

# ── E2E tests (pnpm test:e2e) ───────────────────────────────────
# E2E_EMAIL=chef+clerk_test@example.com   # an existing Clerk user in your dev instance
